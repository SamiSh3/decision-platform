# Application
APP_NAME=decision-platform
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
POSTGRES_USER=decision_user
POSTGRES_PASSWORD=decision_password
POSTGRES_DB=decision_platform
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://decision_user:decision_password@db:5432/decision_platform

# JWT
JWT_SECRET_KEY=change-me-super-secret-key-please-rotate
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
